PORT=3000
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrm?schema=public
# Better Auth secret used to sign sessions and auth tokens.
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Public base URL for the API and auth callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated frontend origins allowed to use Better Auth.
# In development, http://localhost:5000 is trusted automatically.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional uploads directory. Defaults to ./uploads
# UPLOADS_DIR=uploads
# Optional max resume file size in bytes. Defaults to 5242880 (5 MiB).
# RESUME_MAX_FILE_SIZE_BYTES=5242880

# --- Rate limiting ---
# Set to "false" to disable all limiters (useful for local load testing). Defaults to true.
# RATE_LIMIT_ENABLED=true
# Hop count for Express "trust proxy" (set to the number of reverse proxies in front
# of the API, e.g. 1 behind Cloudflare or a single LB). Required so req.ip reflects
# the real client. Defaults to 0 (no proxy).
# TRUST_PROXY_HOPS=0
# Public application submission limiter (POST /api/v1/jobs/:slug/applications).
# Defaults: 5 requests per hour per IP.
# RATE_LIMIT_APPLICATION_WINDOW_MS=3600000
# RATE_LIMIT_APPLICATION_LIMIT=5
# Public read limiter (GET /api/v1/jobs, GET /api/v1/jobs/:slug).
# Defaults: 60 requests per minute per IP.
# RATE_LIMIT_PUBLIC_READ_WINDOW_MS=60000
# RATE_LIMIT_PUBLIC_READ_LIMIT=60
# Better Auth limiter (/api/auth/*, covers sign-in, get-session, etc.).
# Defaults: 100 requests per 15 minutes per IP — high enough that the admin UI's
# session polling doesn't trip it, low enough to still slow down brute force.
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_LIMIT=100
