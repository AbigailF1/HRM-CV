{
  "name": "hrm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.9",
    "@prisma/client": "^6.18.0",
    "better-auth": "^1.6.9",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "mammoth": "1.9.0",
    "multer": "^2.1.1",
    "pdf-parse": "1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.18.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker:email": "tsx src/workers/email.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "test": "vitest run --pool threads",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "pnpm --dir apps/web dev",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "pnpm --dir apps/web build",
    "test:api": "vitest run --pool threads"
  }
}
